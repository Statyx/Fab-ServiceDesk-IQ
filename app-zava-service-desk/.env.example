# Zava Service Desk - demo console
#
# `python -m fabric.app.deploy_app` writes these values for you, into `.env.production.local`
# and `.env.development.local`. Copy this file by hand only to run the app against a workspace
# the deploy script did not configure.
#
# Use `.env.development.local`, NOT `.env.local`: `rayfin env` rewrites `.env.local` on every
# `rayfin up` and every `npm run dev`. Vite gives `.env.development.local` precedence.
# Every value here is inlined into the bundle at build time: they are public identifiers.
# No secret here, ever.
#
# /diagnostic checks that the first five are present, and is not behind sign-in so it stays
# reachable when sign-in fails.

# --- Interactive sign-in (Entra SPA registration) ---------------------------
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# --- Power BI semantic model ------------------------------------------------
# Without it the app shows its structure and no figures. There is no bundled dataset to fall
# back to outside /preview.
VITE_SEMANTIC_MODEL_ID=

# --- Fabric Data Agent (assistant rail) -------------------------------------
VITE_ZAVA_WORKSPACE_ID=
VITE_ZAVA_DATA_AGENT_ID=
# Optional: live graph reads in Zava IQ; use the ontology's Graph Model.
VITE_ZAVA_GRAPH_MODEL_ID=

# Foundry, Work IQ and Web IQ are simulated in this demo: no variable for them.

# --- Hosting -----------------------------------------------------------------
# Fill one block OR the other, not both.
#
# Rayfin: the app runs outside a Fabric item.
VITE_RAYFIN_API_URL=
VITE_RAYFIN_PUBLISHABLE_KEY=
#
# Fabric: the app runs as a Fabric item.
VITE_FABRIC_WORKSPACE_ID=
VITE_FABRIC_ITEM_ID=
VITE_FABRIC_PORTAL_URL=